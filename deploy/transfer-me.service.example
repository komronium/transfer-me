[Unit]
Description=transfer-me
After=network.target

[Service]
Type=simple
User=transfer
Group=transfer
WorkingDirectory=/var/www/transfer-me
EnvironmentFile=/var/www/transfer-me/.env
ExecStart=/var/www/transfer-me/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
